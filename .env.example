# Copy to .env for local development. On Vercel, set these under Project → Settings → Environment Variables.

# Required for the AI assistant — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Database. Leave both unset locally to use ./server/data/sleepsync.db (a plain SQLite file).
# On Vercel use a Turso database (free tier): https://turso.tech
#   turso db create sleepsync && turso db show sleepsync --url && turso db tokens create sleepsync
# TURSO_DATABASE_URL=libsql://sleepsync-<you>.turso.io
# TURSO_AUTH_TOKEN=

# Timezone used to decide what "today" is (servers run in UTC). Default: the machine's timezone.
# APP_TIMEZONE=America/New_York

# Local API server only
# PORT=8000
# HOST=127.0.0.1   # use 0.0.0.0 to let your iPhone reach the dev server over Wi-Fi
