{
  "name": "sleepsync",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm start -w web\"",
    "build": "npm run build -w web",
    "typecheck": "tsc -p server --noEmit && tsc -p web/tsconfig.app.json --noEmit",
    "test": "npm test -w server",
    "shortcut": "tsx scripts/generate-shortcut.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bplist-creator": "^0.3.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
